rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(key) {
      return key is string && key.size() == 10 && key.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 60 &&
             data.calorieGoal is int &&
             data.calorieGoal >= 800 &&
             data.calorieGoal <= 6000 &&
             data.proteinGoal is int &&
             data.proteinGoal >= 10 &&
             data.proteinGoal <= 400 &&
             data.carbsGoal is int &&
             data.carbsGoal >= 10 &&
             data.carbsGoal <= 800 &&
             data.fatGoal is int &&
             data.fatGoal >= 10 &&
             data.fatGoal <= 300 &&
             data.waterGoal is int &&
             data.waterGoal >= 1 &&
             data.waterGoal <= 16 &&
             data.starterSeeded is bool;
    }

    function isValidMealEntry(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             isValidDateKey(data.dateKey) &&
             data.category is string &&
             data.category in ['BREAKFAST', 'LUNCH', 'DINNER', 'SNACK'] &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.detail is string &&
             data.detail.size() <= 200 &&
             data.calories is int &&
             data.calories >= 0 &&
             data.calories <= 5000 &&
             data.proteinGrams is int &&
             data.proteinGrams >= 0 &&
             data.proteinGrams <= 400 &&
             data.carbsGrams is int &&
             data.carbsGrams >= 0 &&
             data.carbsGrams <= 600 &&
             data.fatGrams is int &&
             data.fatGrams >= 0 &&
             data.fatGrams <= 300 &&
             data.source is string &&
             data.source in ['MANUAL', 'PRESET', 'AI_SCAN'] &&
             (!('insight' in data) || (data.insight is string && data.insight.size() <= 240));
    }

    function isValidHydration(data, userId, dateKey) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             isValidDateKey(data.dateKey) &&
             data.dateKey == dateKey &&
             data.glasses is int &&
             data.glasses >= 0 &&
             data.glasses <= 16;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'calorieGoal', 'proteinGoal',
                         'carbsGoal', 'fatGoal', 'waterGoal', 'starterSeeded',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'calorieGoal', 'proteinGoal',
                         'carbsGoal', 'fatGoal', 'waterGoal', 'starterSeeded',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId) &&
                       isValidTimestamp(incoming().createdAt) &&
                       isValidTimestamp(incoming().updatedAt);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'calorieGoal', 'proteinGoal',
                           'carbsGoal', 'fatGoal', 'waterGoal', 'updatedAt'
                         ]) ||
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['starterSeeded', 'updatedAt']) &&
                           incoming().starterSeeded == true
                         )
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /meals/{mealId} {
        allow get: if isOwner(userId) && isValidId(mealId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(mealId) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'category', 'name', 'detail',
                           'calories', 'proteinGrams', 'carbsGrams', 'fatGrams',
                           'source', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'category', 'name', 'detail',
                           'calories', 'proteinGrams', 'carbsGrams', 'fatGrams',
                           'source', 'insight', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMealEntry(incoming(), userId) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidId(mealId) &&
                         isValidMealEntry(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'dateKey', 'category', 'name', 'detail',
                           'calories', 'proteinGrams', 'carbsGrams', 'fatGrams',
                           'insight', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(mealId);
      }

      match /hydration/{dateKey} {
        allow get: if isOwner(userId) && isValidDateKey(dateKey);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         incoming().keys().hasAll([
                           'userId', 'dateKey', 'glasses', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'dateKey', 'glasses', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidHydration(incoming(), userId, dateKey) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidTimestamp(incoming().updatedAt);

        allow update: if isOwner(userId) &&
                         isValidDateKey(dateKey) &&
                         isValidHydration(incoming(), userId, dateKey) &&
                         incoming().userId == existing().userId &&
                         incoming().dateKey == existing().dateKey &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTimestamp(incoming().updatedAt) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'glasses', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidDateKey(dateKey);
      }
    }
  }
}
